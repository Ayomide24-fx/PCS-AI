* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: #070b12;
    color: white;
    font-family: Arial, sans-serif;
}

.app {
    width: 100%;
    max-width: 500px;
    margin: auto;
    padding: 15px;
}

header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 15px 5px 25px;
}

.logo {
    font-size: 40px;
}

h1 {
    margin: 0;
    color: #00eaff;
    font-size: 28px;
}

header p {
    margin: 4px 0 0;
    font-size: 9px;
    color: #788394;
    letter-spacing: 1px;
}

.status {
    margin-left: auto;
    color: #00ff88;
    font-size: 11px;
    font-weight: bold;
}

.status span {
    display: inline-block;
    width: 7px;
    height: 7px;
    background: #00ff88;
    border-radius: 50%;
    margin-right: 4px;
}

.panel {
    background: #101722;
    border: 1px solid #1d2938;
    border-radius: 14px;
    margin-bottom: 12px;
    padding: 16px;
}

.panel-title {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    font-weight: bold;
    color: #aeb8c5;
    margin-bottom: 15px;
}

.live {
    color: #00ff88;
}

.market {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-top: 15px;
}

small {
    display: block;
    color: #687586;
    font-size: 9px;
    margin-bottom: 7px;
}

strong {
    font-size: 14px;
}

.bullish {
    color: #00ff88;
}

.bearish {
    color: #ff4d6d;
}

label {
    display: block;
    text-align: left;
    color: #8c98a8;
    font-size: 11px;
    margin-top: 10px;
}

input,
select {
    width: 100%;
    padding: 11px;
    margin-top: 5px;
    background: #080d15;
    color: white;
    border: 1px solid #263548;
    border-radius: 8px;
    outline: none;
}

input:focus,
select:focus {
    border-color: #00eaff;
}

button {
    width: 100%;
    padding: 13px;
    margin-top: 15px;
    background: #00eaff;
    color: #001014;
    border: none;
    border-radius: 8px;
    font-weight: bold;
    cursor: pointer;
}

button:active {
    transform: scale(0.98);
}

.signal-panel {
    background: #111a16;
    border: 1px solid #26352d;
    border-radius: 14px;
    padding: 22px;
    text-align: center;
    margin-bottom: 12px;
}

.signal-title {
    color: #7d8b9c;
    font-size: 11px;
    letter-spacing: 2px;
}

.signal {
    font-size: 42px;
    font-weight: bold;
    margin: 10px 0;
}

.reason {
    color: #aab5c2;
    font-size: 12px;
}


/* CONFIDENCE */

.confidence-box {
    margin-top: 20px;
    padding-top: 15px;
    border-top: 1px solid #263548;
}

.confidence-title {
    color: #7d8b9c;
    font-size: 10px;
    letter-spacing: 2px;
}

.confidence-bar {
    width: 100%;
    height: 10px;
    background: #080d15;
    border-radius: 10px;
    overflow: hidden;
    margin-top: 10px;
}

.confidence-fill {
    width: 0%;
    height: 100%;
    background: #00ff88;
    transition: width 0.4s ease;
}

#confidenceValue {
    color: #00eaff;
    margin: 10px 0 5px;
}

#confidenceStatus {
    color: #aab5c2;
    font-size: 11px;
}


/* TRADE GRID */

.trade-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
}

.cyan {
    color: #00eaff;
}

footer {
    text-align: center;
    color: #465262;
    font-size: 10px;
    padding: 15px;
}
